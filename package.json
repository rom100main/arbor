{
    "name": "arbor",
    "productName": "Arbor",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "main": "dist/electron/main/index.js",
    "scripts": {
        "dev": "vp dev",
        "build": "tsc && vp build",
        "build:icons": "node scripts/build-icons.ts",
        "preview": "vp preview",
        "test": "vp test",
        "check": "vp check",
        "lint": "vp lint",
        "lint:css": "stylelint \"src/**/*.css\"",
        "fmt": "vp fmt"
    },
    "devDependencies": {
        "@solidjs/vite-plugin": "^3.0.0-next.44",
        "@types/node": "^26.6.2",
        "electron": "^44.4.3",
        "stylelint": "^17.15.0",
        "stylelint-config-recess-order": "^7.8.0",
        "stylelint-config-standard": "^40.0.0",
        "typescript": "~6.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
        "vite-plugin-electron": "^1.1.2",
        "vite-plus": "0.3.3"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3"
    },
    "devEngines": {
        "packageManager": {
            "name": "npm",
            "version": "11.19.1",
            "onFail": "download"
        }
    },
    "dependencies": {
        "@solidjs/web": "^2.0.0-rc.9",
        "@tabler/icons": "^3.47.0",
        "effect": "^3.22.2",
        "electron-chrome-context-menu": "^1.1.0",
        "electron-chrome-extensions": "^4.9.0",
        "electron-chrome-web-store": "^0.13.0",
        "solid-js": "^2.0.0-rc.9"
    },
    "allowScripts": {
        "electron@44.4.3": true,
        "fsevents@2.3.3": true
    }
}
