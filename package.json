{
    "name": "arbor",
    "productName": "Arbor",
    "private": true,
    "version": "0.1.0",
    "description": "A desktop browser that keeps tabs as trees.",
    "author": "rom100main",
    "repository": "github:rom100main/arbor",
    "type": "module",
    "main": "dist/electron/main/index.js",
    "scripts": {
        "dev": "vp dev",
        "build": "tsc && vp build && node scripts/check-preload.ts",
        "dist": "npm run build && electron-builder",
        "dist:dir": "npm run build && electron-builder --dir",
        "check:preload": "node scripts/check-preload.ts",
        "build:icons": "node scripts/build-icons.ts",
        "licenses:generate": "node scripts/licenses/generate.ts",
        "licenses:check": "node scripts/licenses/check.ts",
        "preview": "vp preview",
        "test": "vp test",
        "check": "vp check",
        "lint": "vp lint",
        "lint:css": "stylelint \"src/**/*.css\"",
        "fmt": "vp fmt"
    },
    "dependencies": {
        "@solidjs/web": "^2.0.0-rc.21",
        "@tabler/icons": "^3.50.0",
        "effect": "^4.1.2",
        "electron-chrome-extensions": "^4.10.0",
        "electron-chrome-web-store": "^0.13.0",
        "electron-updater": "^6.8.11",
        "solid-js": "^2.0.0-rc.21"
    },
    "devDependencies": {
        "@solidjs/vite-plugin": "^3.0.0-next.57",
        "@types/node": "^26.6.6",
        "electron": "^45.2.3",
        "electron-builder": "26.18.1",
        "generate-license-file": "^4.2.5",
        "stylelint": "^17.16.0",
        "stylelint-config-recess-order": "^7.10.0",
        "stylelint-config-standard": "^40.0.0",
        "typescript": "^7.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
        "vite-plugin-electron": "^1.2.0",
        "vite-plus": "1.5.0"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
        "adm-zip": "^0.6.1",
        "minimatch@^9.0.3": "11.0.5",
        "minimatch@^10.2.5": "11.0.5"
    },
    "devEngines": {
        "packageManager": {
            "name": "npm",
            "version": ">=10 <12",
            "onFail": "download"
        }
    },
    "allowScripts": {
        "electron@45.2.3": true,
        "fsevents@2.3.3": true,
        "electron-winstaller@5.4.0": true
    }
}
